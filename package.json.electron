{
  "name": "ai-companion",
  "productName": "AI Companion",
  "version": "0.1.0",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.yourname.aicompanion",
    "files": ["**/*"],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "electron-auto-launch": "^5.0.0",
    "node-fetch": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
